---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allDucks = await getCollection('ducks');
  
  return allDucks.map(duck => {
    return {
      params: { id: duck.data.tokenId },
      props: { duck: duck.data }
    };
  });
}

const { duck } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const site = import.meta.env.SITE;
const fullUrl = site + baseUrl + '/duck/' + duck.tokenId;

// Sort traits by trait_type number (prefix)
const sortedTraits = [...duck.gameData.traits].sort((a, b) => {
  const getOrder = (type) => {
    const traitTypes = duck.attributes.map(attr => attr.trait_type);
    return traitTypes.findIndex(t => t.includes(type));
  };
  return getOrder(a.type) - getOrder(b.type);
});

// Helper for displaying rarity
const getRarityColors = (rarity) => {
  switch(rarity) {
    case 'C': return { text: 'Common', class: 'badge-neutral' };
    case 'U': return { text: 'Uncommon', class: 'badge-info' };
    case 'R': return { text: 'Rare', class: 'badge-secondary' };
    case 'E': return { text: 'Epic', class: 'badge-primary' };
    case 'L': return { text: 'Legendary', class: 'badge-warning' };
    case 'M': return { text: 'Mythic', class: 'badge-error' };
    default: return { text: rarity, class: 'badge-accent' };
  }
};

// Prepare social share text
const shareText = encodeURIComponent(`Check out ${duck.name} (${duck.gameData.rarity}) from the Dead Duck NFT collection!`);
const shareUrl = encodeURIComponent(fullUrl);
const twitterShareUrl = `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`;
---

<Layout title={duck.name}>
  <!-- Add OpenGraph meta tags for social sharing -->
  <meta slot="head" property="og:title" content={duck.name} />
  <meta slot="head" property="og:description" content={`${duck.gameData.name} - ${duck.gameData.class} - ${duck.gameData.rarity}`} />
  <meta slot="head" property="og:image" content={`${site}${baseUrl}/images/ducks/${duck.tokenId}.webp`} />
  <meta slot="head" property="og:url" content={fullUrl} />
  <meta slot="head" property="og:type" content="website" />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="mb-4 flex justify-between items-center">
    <a href={`${baseUrl}/page/1`} class="btn btn-ghost">
      ← Back to Gallery
    </a>
    <a href={twitterShareUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="mr-2">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
      </svg>
      Share on X
    </a>
  </div>
  
  <!-- Duck header section -->
  <div class="card bg-base-100 shadow-xl mb-6">
    <div class="flex flex-col md:flex-row">
      <figure class="md:w-1/3 p-4 flex justify-center">
        <img 
          src={`${baseUrl}/images/ducks/${duck.tokenId}.webp`} 
          alt={duck.name} 
          class="rounded-xl object-contain max-h-[400px] w-auto"
        />
      </figure>
      
      <div class="card-body md:w-2/3">
        <div class="flex justify-between items-center">
          <h1 class="card-title text-3xl">{duck.name}</h1>
          <div class="badge badge-lg badge-primary">{duck.gameData.rarity}</div>
        </div>
        
        <div class="divider my-2"></div>
        
        <div class="mb-4">
          <h2 class="text-xl font-bold">"{duck.gameData.name}" - {duck.gameData.class}</h2>
          <p class="mt-2 text-base-content/80">{duck.gameData.backstory}</p>
        </div>
        
        <!-- Stats section -->
        <div class="stats stats-vertical sm:stats-horizontal shadow mb-4 w-full">
          <div class="stat">
            <div class="stat-title">STR</div>
            <div class="stat-value text-primary">{duck.gameData.stats.strength}</div>
            <div class="stat-desc">
              <progress 
                class="progress progress-primary w-full" 
                value={duck.gameData.stats.strength} 
                max="100"
              ></progress>
            </div>
          </div>
          
          <div class="stat">
            <div class="stat-title">AGI</div>
            <div class="stat-value text-secondary">{duck.gameData.stats.agility}</div>
            <div class="stat-desc">
              <progress 
                class="progress progress-secondary w-full" 
                value={duck.gameData.stats.agility} 
                max="100"
              ></progress>
            </div>
          </div>
          
          <div class="stat">
            <div class="stat-title">INT</div>
            <div class="stat-value text-accent">{duck.gameData.stats.intelligence}</div>
            <div class="stat-desc">
              <progress 
                class="progress progress-accent w-full" 
                value={duck.gameData.stats.intelligence} 
                max="100"
              ></progress>
            </div>
          </div>
          
          <div class="stat">
            <div class="stat-title">LCK</div>
            <div class="stat-value text-success">{duck.gameData.stats.luck}</div>
            <div class="stat-desc">
              <progress 
                class="progress progress-success w-full" 
                value={duck.gameData.stats.luck} 
                max="100"
              ></progress>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Duck details section -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Left column -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h3 class="card-title text-xl">Personality</h3>
        <p class="text-base-content/80">{duck.gameData.personality}</p>
        
        <div class="divider"></div>
        
        <h3 class="card-title text-xl">Special Ability: {duck.gameData.specialAbility.name}</h3>
        <p class="text-base-content/80">{duck.gameData.specialAbility.description}</p>
      </div>
    </div>
    
    <!-- Right column -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h3 class="card-title text-xl">Traits</h3>
        <div class="overflow-x-auto">
          <table class="table table-zebra w-full">
            <thead>
              <tr>
                <th>Type</th>
                <th>Value</th>
                <th>Rarity</th>
              </tr>
            </thead>
            <tbody>
              {sortedTraits.map(trait => {
                const rarityInfo = getRarityColors(trait.rarity);
                return (
                  <tr>
                    <td>{trait.type}</td>
                    <td>{trait.value}</td>
                    <td>
                      <div class={`badge ${rarityInfo.class}`}>
                        {rarityInfo.text}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Navigation buttons -->
  <div class="flex justify-between mt-6">
    {parseInt(duck.tokenId) > 1 ? (
      <a href={`${baseUrl}/duck/${parseInt(duck.tokenId) - 1}`} class="btn btn-primary">
        ← Previous Duck
      </a>
    ) : <div></div>}
    
    {parseInt(duck.tokenId) < 447 && (
      <a href={`${baseUrl}/duck/${parseInt(duck.tokenId) + 1}`} class="btn btn-primary">
        Next Duck →
      </a>
    )}
  </div>
</Layout>