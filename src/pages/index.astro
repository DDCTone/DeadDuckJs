---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import crackedLogo from '../assets/cracked.png';

// Count the number of ducks to show in progress bar
const ducks = await getCollection('ducks');
const mintedCount = ducks.length;
const totalCount = 3333;
const progressPercentage = (mintedCount / totalCount) * 100;

const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="Dead Ducks Collective - Home">
  <div 
    class="hero min-h-screen rounded-lg"
    style={`background-image: url(${baseUrl}/banner.png);`}
  >
    <div class="hero-overlay bg-opacity-60 rounded-lg"></div>
    <div class="hero-content text-center text-neutral-content">
      <div class="max-w-3xl">
        <div class="mb-6 flex justify-center">
          <img 
            src={`${baseUrl}/DDC_Logo.avif`} 
            alt="DDC Logo" 
            class="w-[309px] h-[238px] object-cover rounded-lg"
            width="309"
            height="238"
            fetchpriority="high"
          />
        </div>
        
        <div class="bg-[rgba(0,0,0,0.9)] p-8 rounded-lg mb-8">
          <h1 class="text-5xl font-bold mb-6 text-primary">THE DEAD DUCKS HAVE LANDED</h1>
          <p class="mb-8 text-xl">
            Dead Ducks Collective is a generative NFT collection of 3,333 post-apocalyptic AI ducks resurrected from a corrupted Solana trader's wallet and glitched into existence by a rogue AI long after humanity vanished.
          </p>
          
          <a href={`${baseUrl}/page/1`}
             class="btn btn-secondary btn-lg tracking-widest text-xl">
            VIEW GALLERY
          </a>
        </div>
      </div>
    </div>
  </div>

  <main class="flex flex-col items-center py-12">
    <div class="card bg-base-300 shadow-xl w-full max-w-2xl mb-10">
      <div class="card-body">
        <h2 class="card-title text-2xl mb-4">Minting Progress</h2>
        <div class="flex justify-between mb-2">
          <span class="badge badge-primary badge-lg">{mintedCount} minted</span>
          <span class="badge badge-secondary badge-lg">{totalCount} total</span>
        </div>
        <progress class="progress progress-primary w-full" value={mintedCount} max={totalCount}></progress>
        <p class="text-center text-sm mt-2">{Math.round(progressPercentage)}% Complete</p>
      </div>
    </div>

    <div class="join join-vertical sm:join-horizontal gap-4">
      <a href="https://t.co/WAQZ49ELSb" 
         target="_blank" 
         rel="noopener noreferrer" 
         class="btn btn-primary join-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 640 512" fill="currentColor"><path d="M524.5 69.8a1.5 1.5 0 0 0 -.8-.7A485.1 485.1 0
         0 0 404.1 32a1.8 1.8 0 0 0 -1.9 .9 337.5 337.5 0 0 0 -14.9 30.6 447.8 447.8 0 0 0 -134.4 0 309.5 309.5 0 0 0 -15.1-30.6 1.9 1.9 0 0 0 -1.9-.9A483.7 483.7 0 0 0 116.1 69.1a1.7 1.7 0 0 0 -.8 .7C39.1 183.7 18.2 294.7 28.4 404.4a2 2 0 0 0 .8 1.4A487.7 487.7 0 0 0 176 479.9a1.9 1.9 0 0 0 2.1-.7A348.2 348.2 0 0 0 208.1 430.4a1.9 1.9 0 0 0 -1-2.6 321.2 321.2 0 0 1 -45.9-21.9 1.9 1.9 0 0 1 -.2-3.1c3.1-2.3 6.2-4.7 9.1-7.1a1.8 1.8 0 0 1 1.9-.3c96.2 43.9 200.4 43.9 295.5 0a1.8 1.8 0 0 1 1.9 .2c2.9 2.4 6 4.9 9.1 7.2a1.9 1.9 0 0 1 -.2 3.1 301.4 301.4 0 0 1 -45.9 21.8 1.9 1.9 0 0 0 -1 2.6 391.1 391.1 0 0 0 30 48.8 1.9 1.9 0 0 0 2.1 .7A486.1 486.1 0 0 0 610.7 405.7a1.9 1.9 0 0 0 .8-1.4C623.7 277.6 590.9 167.5 524.5 69.8zM222.5 337.6c-29 0-52.8-26.6-52.8-59.2S193.1 219.1 222.5 219.1c29.7 0 53.3 26.8 52.8 59.2C275.3 311 251.9 337.6 222.5 337.6zm195.4 0c-29 0-52.8-26.6-52.8-59.2S388.4 219.1 417.9 219.1c29.7 0 53.3 26.8 52.8 59.2C470.7 311 447.5 337.6 417.9 337.6z"/></svg>
        Discord
      </a>
      <a href="https://x.com/DeadDucks_NFT" 
         target="_blank" 
         rel="noopener noreferrer" 
         class="btn btn-primary join-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 512 512" fill="currentColor"><path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z"/></svg>
        X / Twitter
      </a>
      <a href="https://t.me/DeadDucksCollective" 
         target="_blank" 
         rel="noopener noreferrer" 
         class="btn btn-primary join-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 496 512" fill="currentColor"><path d="M248 8C111 8 0 119 0 256S111 504 248 504 496 393 496 256 385 8 248 8zM363 176.7c-3.7 39.2-19.9 134.4-28.1 178.3-3.5 18.6-10.3 24.8-16.9 25.4-14.4 1.3-25.3-9.5-39.3-18.7-21.8-14.3-34.2-23.2-55.3-37.2-24.5-16.1-8.6-25 5.3-39.5 3.7-3.8 67.1-61.5 68.3-66.7 .2-.7 .3-3.1-1.2-4.4s-3.6-.8-5.1-.5q-3.3 .7-104.6 69.1-14.8 10.2-26.9 9.9c-8.9-.2-25.9-5-38.6-9.1-15.5-5-27.9-7.7-26.8-16.3q.8-6.7 18.5-13.7 108.4-47.2 144.7-62.3c68.9-28.6 83.2-33.6 92.5-33.8 2.1 0 6.6 .5 9.6 2.9a10.5 10.5 0 0 1 3.5 6.7A43.8 43.8 0 0 1 363 176.7z"/></svg>
        Telegram
      </a>
    </div>
  </main>
</Layout>