  "gameData": {
    "backstory": "Born in the shadow of Subchain City's defunct refineries, Rusty grew up scavenging scrap metal among the rusted hulks. He's always been a loner, preferring the company of broken machines to other ducks, but he has a knack for fixing things – and fighting dirty.",
    "class": "Mechanic Raider",
    "name": "Rusty Sprocket",
