  "gameData": {
    "backstory": "Born in the arcade ruins of the Bldg Fun Boxes, Glitch grew up scavenging for spare parts and mastering forgotten game consoles. The parasite in his eye offers both a curse and blessing - granting him uncanny vision, but at the cost of fading memories.",
    "class": "Hacker",
    "name": "Glitch",
