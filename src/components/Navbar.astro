---
// Get base URL from Astro config
import { Image } from 'astro:assets';
import crackedLogo from '../assets/cracked.png';

const baseUrl = import.meta.env.BASE_URL;
---

<div class="navbar bg-base-300 rounded-lg mb-6 shadow-lg">
  <div class="navbar-start">
    <a href={`${baseUrl}/`} class="btn btn-ghost text-xl">
      <Image src={crackedLogo} alt="Logo" width="24" height="24" class="mr-2 rounded-full" />
      Dead Duck NFTs
    </a>
  </div>
  
  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal">
      <li><a href={`${baseUrl}/`} class="hover:text-primary">Home</a></li>
      <li><a href={`${baseUrl}/page/1`} class="hover:text-primary">Gallery</a></li>
    </ul>
  </div>
  
  <div class="navbar-end">
    <a href="https://nft-generator.art/mints/cm90ffccy006003jv3i2x40bn" target="_blank" rel="noreferrer noopener" class="btn btn-primary btn-sm hidden md:flex">
      MINT NOW
    </a>
  </div>
</div>