---
// Get base URL from Astro config
const baseUrl = import.meta.env.BASE_URL;
---

<div class="navbar bg-base-200 rounded-lg mb-6">
  <div class="navbar-start">
    <a href={`${baseUrl}/page/1`} class="btn btn-ghost text-xl">
      <img src={`${baseUrl}/favicon.svg`} alt="Logo" width="24" height="24" class="mr-2" />
      Dead Duck NFTs
    </a>
  </div>
  
  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal">
      <li><a href={`${baseUrl}/page/1`}>Gallery</a></li>
    </ul>
  </div>
  
  <div class="navbar-end">
    <!-- Empty navbar-end section preserved for symmetry -->
  </div>
</div>