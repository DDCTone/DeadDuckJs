---
import { Image } from 'astro:assets';
import crackedLogo from '../assets/cracked.png';

const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="bg-base-300 text-base-content mt-8 shadow-inner">
  <div class="max-w-7xl mx-auto px-4 py-6">
    <div class="flex flex-wrap justify-between items-center">
      <div class="flex items-center mb-4 md:mb-0">
        <a href={`${baseUrl}/`} class="flex items-center">
          <Image src={crackedLogo} alt="Logo" width="40" height="40" class="mr-3 rounded-full" />
          <span class="text-lg font-bold">Dead Duck NFTs</span>
        </a>
      </div>
      
      <div class="flex gap-4">
        <a href={`${baseUrl}/`} class="link link-hover">Home</a>
        <a href={`${baseUrl}/page/1`} class="link link-hover">Gallery</a>
      </div>
      
